# NEUQ 教务系统凭证（必填）
YOUR_NEUQ_USERNAME=你的学号
YOUR_NEUQ_PASSWORD=你的密码

# 教务系统 URL（可选，默认为 VPN 重写地址）
# NEUQ_JWXT_BASE_URL=https://vpn.neuq.edu.cn/http/77726476706e69737468656265737421fae05988693e6d456f468ca88d1b203b/eams/

# ---- WebVPN 门户（校外访问时启用，可选）----
# 是否先登录 WebVPN 门户。留空时自动根据 base_url 是否包含 "vpn." 判断
# NEUQ_VPN_ENABLED=true
# 门户地址（协议+主机，可选，默认从 base_url 推导）
# NEUQ_VPN_BASE_URL=https://vpn.neuq.edu.cn
# 门户账号/密码（可选，缺省回退使用上面的教务账号密码）
# NEUQ_VPN_USERNAME=
# NEUQ_VPN_PASSWORD=
# 门户认证方式：cas=统一认证（默认，推荐）；local=门户本地账号
# NEUQ_VPN_AUTH_METHOD=cas

# 请求超时时间（秒，默认 45）
# REQUEST_TIMEOUT_SECS=45

# 请求间隔时间（毫秒，默认 2000）
# REQUEST_DELAY_MS=2000

# 总共处理的天数（1-30，默认 7）
# TOTAL_DAYS=7

# 最大重试次数（默认 3）
# MAX_RETRIES=3

# 输出目录（默认 ./output）
# OUTPUT_DIR=./output

# 静态资源目录（默认 ./assets）
# ASSETS_DIR=./assets

# 是否覆盖已有数据（默认 false）
# FORCE_OVERWRITE=false

# 是否压缩 HTML 输出（默认 true）
# MINIFY_HTML=true
